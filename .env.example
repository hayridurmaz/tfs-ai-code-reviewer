# Azure DevOps
ADO_BASE_URL=https://your-ado-server.com/DefaultCollection
ADO_PAT=your_personal_access_token_here

# LLM
LLM_BASE_URL=https://your-internal-llm.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4

# Bot ayarları
POLL_INTERVAL_SEC=90
PROJECT_NAME=YourProjectName
# Birden fazla repo için virgülle ayırın, boş bırakırsanız tüm repolar
REPO_NAMES=
TARGET_BRANCHES=main
IGNORE_PR_IDS=

# Yorum ayarları
MAX_COMMENTS_PER_FILE=3
MIN_CONFIDENCE=0.65
# Azure DevOps
ADO_BASE_URL=https://your-ado-server.com/DefaultCollection
ADO_PAT=your_personal_access_token_here

# LLM
LLM_BASE_URL=https://your-internal-llm.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=kimi-k2-turbo-preview
LLM_MAX_RETRIES=3

# Bot ayarları
POLL_INTERVAL_SEC=90
PROJECT_NAME=YourProjectName
MAX_CONCURRENT_PRS=5
# Birden fazla repo için virgülle ayırın, boş bırakırsanız tüm repolar
REPO_NAMES=
TARGET_BRANCHES=main
IGNORE_PR_IDS=

# Yorum ayarları
MAX_COMMENTS_PER_FILE=3
MIN_CONFIDENCE=0.65
MAX_FILES_PER_BATCH=5
ENABLE_SELF_CORRECTION=true  # 0 = no batching, sends all files in one request

# Data paths
LOG_PATH=data/app.log
DB_PATH=data/bot-state.db